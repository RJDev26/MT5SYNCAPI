<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-OTS.WorkflowService-038de91f-eea7-42cc-bca5-aec7a6daa628</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The native MT5 Manager API (net2.0 mixed-mode, x64) is NOT referenced here.
      It lives in the net48 OTS.Mt5Bridge sidecar; this worker calls it over HTTP.
    -->
    <PackageReference Include="MetaQuotes.MT5ManagerAPI64-net2.0" Version="1755.0.0" />
    <PackageReference Include="MetaTrader.Common" Version="1.1.0.9" />
    <PackageReference Include="MetaTrader.Sdk" Version="1.1.0.12" />
    <PackageReference Include="MetaTrader5.Net.API" Version="1.0.2" />
    <PackageReference Include="MetaTrader5Terminal" Version="1.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>
</Project>
